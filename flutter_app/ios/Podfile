ios_deployment_target = '15.0'

platform :ios, ios_deployment_target

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

def patch_file_contents(path, replacements)
  return unless File.exist?(path)

  original = File.read(path)
  patched = replacements.reduce(original) do |content, (needle, replacement)|
    content.gsub(needle, replacement)
  end
  return if patched == original

  File.write(path, patched)
end

def patch_pods_runner_support_files
  support_files_dir = File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-Runner')
  resources_script_replacements = {
    "}\nif [[ \"$CONFIGURATION\" == \"Debug\" ]]; then\n" => <<~'SCRIPT',
}

resolve_generated_resource_path()
{
  local pod_name="$1"
  local bundle_name="$2"
  local flat_path="${PODS_CONFIGURATION_BUILD_DIR}/${bundle_name}"
  local nested_path="${PODS_CONFIGURATION_BUILD_DIR}/${pod_name}/${bundle_name}"
  if [[ -e "$flat_path" ]] ; then
    echo "$flat_path"
  else
    echo "$nested_path"
  fi
}

if [[ "$CONFIGURATION" == "Debug" ]]; then
SCRIPT
    'install_resource "${PODS_CONFIGURATION_BUILD_DIR}/firebase_messaging/firebase_messaging_Privacy.bundle"' =>
      'install_resource "$(resolve_generated_resource_path "firebase_messaging" "firebase_messaging_Privacy.bundle")"',
    'install_resource "${PODS_CONFIGURATION_BUILD_DIR}/google_sign_in_ios/google_sign_in_ios_privacy.bundle"' =>
      'install_resource "$(resolve_generated_resource_path "google_sign_in_ios" "google_sign_in_ios_privacy.bundle")"',
    'install_resource "${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple/permission_handler_apple_privacy.bundle"' =>
      'install_resource "$(resolve_generated_resource_path "permission_handler_apple" "permission_handler_apple_privacy.bundle")"',
  }

  resources_input_replacements = {
    '${PODS_CONFIGURATION_BUILD_DIR}/firebase_messaging/firebase_messaging_Privacy.bundle' => '${PODS_CONFIGURATION_BUILD_DIR}/firebase_messaging_Privacy.bundle',
    '${PODS_CONFIGURATION_BUILD_DIR}/google_sign_in_ios/google_sign_in_ios_privacy.bundle' => '${PODS_CONFIGURATION_BUILD_DIR}/google_sign_in_ios_privacy.bundle',
    '${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple/permission_handler_apple_privacy.bundle' => '${PODS_CONFIGURATION_BUILD_DIR}/permission_handler_apple_privacy.bundle',
  }

  patch_file_contents(
    File.join(__dir__, 'Runner.xcodeproj', 'project.pbxproj'),
    {
      '\"${PODS_ROOT}/Target Support Files/Pods-Runner/Pods-Runner-frameworks.sh\"\n' =>
        '/bin/sh \"${PODS_ROOT}/Target Support Files/Pods-Runner/Pods-Runner-frameworks.sh\"\n',
      '\"${PODS_ROOT}/Target Support Files/Pods-Runner/Pods-Runner-resources.sh\"\n' =>
        '/bin/sh \"${PODS_ROOT}/Target Support Files/Pods-Runner/Pods-Runner-resources.sh\"\n',
    },
  )

  patch_file_contents(
    File.join(support_files_dir, 'Pods-Runner-resources.sh'),
    resources_script_replacements,
  )

  %w[Debug Release Profile].each do |configuration|
    patch_file_contents(
      File.join(support_files_dir, "Pods-Runner-resources-#{configuration}-input-files.xcfilelist"),
      resources_input_replacements,
    )
  end

end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = ios_deployment_target
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end

post_integrate do |_installer|
  patch_pods_runner_support_files
end
