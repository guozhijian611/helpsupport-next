# 生产环境配置模板
# docker.sh 默认会把本文件复制为镜像内 /app/.env，供 .bin 运行时读取。
# 上线前请替换数据库、Redis、RabbitMQ、AI 服务等生产配置。
#
# Docker 容器访问宿主机服务时，主机地址通常写 host.docker.internal。
# docker.sh 默认会为 Linux Docker 添加：
# --add-host host.docker.internal:host-gateway
# 因此数据库、Redis、RabbitMQ 跑在宿主机上时，默认使用 host.docker.internal。
# 如果服务在同一个 Docker 网络内，请改成对应容器名，并在 docker.sh 配置 REMOTE_DOCKER_NETWORK。

# 数据库配置
DB_TYPE = mysql
DB_HOST = host.docker.internal
DB_PORT = 3306
DB_NAME = b8aiadmin
DB_USER = b8aiadmin
DB_PASSWORD = b8aiadmin
DB_PREFIX = ''
DB_CHARSET = utf8mb4
DB_COLLATION = utf8mb4_general_ci

# 缓存方式,支持file|redis
CACHE_MODE = file

# Redis配置
REDIS_HOST = host.docker.internal
REDIS_PORT = 6379
REDIS_PASSWORD = 'openb8'
REDIS_DB = 0
REDIS_QUEUE_PREFIX = ''
REDIS_QUEUE_MAX_ATTEMPTS = 5
REDIS_QUEUE_RETRY_SECONDS = 5

# RabbitMQ配置
RABBITMQ_HOST = host.docker.internal
RABBITMQ_PORT = 5672
RABBITMQ_VHOST = /
RABBITMQ_USERNAME = admin
RABBITMQ_PASSWORD = admin
RABBITMQ_DEBUG = false
RABBITMQ_TIMEOUT = 10
RABBITMQ_RESTART_INTERVAL = 5

# RabbitMQ Management API，用于后台队列运行页读取实时积压并清空队列
RABBITMQ_MANAGEMENT_SCHEME = http
RABBITMQ_MANAGEMENT_HOST = host.docker.internal
RABBITMQ_MANAGEMENT_PORT = 15672
RABBITMQ_MANAGEMENT_USERNAME = admin
RABBITMQ_MANAGEMENT_PASSWORD = admin
RABBITMQ_MANAGEMENT_TIMEOUT = 3

# Webman 事件循环；RabbitMQ 消费者默认使用 Fiber 协程事件循环
WEBMAN_EVENT_LOOP = Workerman\Events\Fiber

# 验证码配置,支持cache|session
CAPTCHA_MODE = cache

#前端目录
FRONTEND_DIR = saiadmin-artd

# OpenAI 兼容 AI 服务；后台 saiai 配置优先，未启用后台配置时使用这里的默认模型
OPENAI_API_KEY = ''
OPENAI_BASE_URL = ''

# saiai 阿里云实时语音 WebSocket 代理；由后台测试页连接，本地代理再转发到百炼实时端点
SAIAI_REALTIME_WS_PORT = 8791
SAIAI_REALTIME_WS_COUNT = 1
DASHSCOPE_API_KEY = ''

# Adminer 数据库管理入口，生产环境默认关闭，需要运维确认后再开启
ADMINER_ENABLED = false

# Webman 日志查看器入口；留空时跟随 APP debug，仅建议本地或受控内网开启
LOG_READER_ENABLED = false

# OpenTelemetry Trace 调试日志
# Logic/Service 手动业务 span 开关；生产可单独关闭它并保留 HTTP/SQL/request log。
OTEL_BUSINESS_SPAN = true
# 业务 span 本地文件日志，供 /__trace 页面展示 Logic/Service 时间线。
OTEL_BUSINESS_SPAN_FILE = true
# 记录请求头后会包含 Authorization/Cookie 等字段；默认仍会按敏感字段脱敏。
OTEL_REQUEST_LOG_INCLUDE_HEADERS = false
# 仅本地临时排查时才建议改为 false，关闭后会记录 Bearer/Cookie/Token 原文。
OTEL_REQUEST_LOG_MASK_SENSITIVE = true
