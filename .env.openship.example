# Copy this file to .env for local Docker Compose, or configure the same
# variables in the Openship project environment.

MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_NAME=helpsupport
DB_USER=helpsupport
DB_PASSWORD=replace-with-a-strong-database-password

REDIS_PASSWORD=replace-with-a-strong-redis-password
RABBITMQ_USERNAME=helpsupport
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password

# Openship should route the gateway service on container port 8080.
APP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Production migrations are opt-in. Enable only after confirming the target
# database, backup and rollback window. Set back to 0 after a successful deploy.
B8_RUN_MIGRATIONS=0

WEBMAN_HTTP_WORKERS=4
SAIAI_REQUEST_TIMEOUT=3600
SAIAI_REALTIME_WS_COUNT=1

OPENAI_API_KEY=
OPENAI_BASE_URL=
DASHSCOPE_API_KEY=

OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
