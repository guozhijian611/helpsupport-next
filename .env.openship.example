# Copy this file to .env for optional local Docker Compose overrides.
# Passwords may stay empty: the first deployment generates and persists them.

MYSQL_ROOT_PASSWORD=
DB_NAME=helpsupport
DB_USER=helpsupport
DB_PASSWORD=

REDIS_PASSWORD=
RABBITMQ_USERNAME=helpsupport
RABBITMQ_PASSWORD=

# Openship should route the gateway service on container port 8080.
APP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Production migrations are opt-in. Enable only after confirming the target
# database, backup and rollback window. Set back to 0 after a successful deploy.
B8_RUN_MIGRATIONS=0

WEBMAN_HTTP_WORKERS=4
SAIAI_REQUEST_TIMEOUT=3600
SAIAI_REALTIME_WS_COUNT=1

OPENAI_API_KEY=
OPENAI_BASE_URL=
DASHSCOPE_API_KEY=

OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
